{
  "presets": {
  },
  "validations": {
    "integer_gt_zero": {
      "description": "a whole number > 0",
      "args": [
        "duration"
      ],
      "vals": "^[1-9][0-9]*$"
    },
    "threshold": {
      "description": "latency threshold (e.g. 1us, 10us, or whole number of microseconds)",
      "args": [
        "threshold"
      ],
      "vals": "^[1-9][0-9]*(us)?$"
    }
  }
}
